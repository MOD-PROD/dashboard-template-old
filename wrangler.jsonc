{
  // MOD-PROD Control Center — déploiement séparé d'AppMod.
  // Préparer Cloudflare Access AVANT d'activer le domaine personnalisé.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modprod-dashboard",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
